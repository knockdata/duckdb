{
	"name": "@knockdata/duckdb",
	"version": "1.5.5-r.2",
	"description": "A minimal DuckDB build for browsing database files — native addon and wasm from one source",
	"type": "module",
	"main": "index.js",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/knockdata/duckdb.git"
	},
	"keywords": ["duckdb", "database", "wasm", "napi"],
	"exports": {
		".": "./index.js",
		"./browser.js": "./browser.js",
		"./engineDir.js": "./engineDir.js",
		"./entries.js": "./entries.js",
		"./wasm/duckdb.js": "./wasm/duckdb.js",
		"./wasm/duckdb.wasm": "./wasm/duckdb.wasm",
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "bash build.sh",
		"test": "node test/engines.js"
	},
	"files": [
		"index.js",
		"entries.js",
		"node.js",
		"browser.js",
		"engineDir.js",
		"wasm/duckdb.js",
		"wasm/duckdb.wasm",
		"wasm/core.js",
		"README.md"
	],
	"optionalDependencies": {
		"@knockdata/duckdb-darwin-arm64": "1.5.5-r.2",
		"@knockdata/duckdb-darwin-x64": "1.5.5-r.2",
		"@knockdata/duckdb-linux-arm64": "1.5.5-r.2",
		"@knockdata/duckdb-linux-x64": "1.5.5-r.2",
		"@knockdata/duckdb-win32-arm64": "1.5.5-r.2",
		"@knockdata/duckdb-win32-x64": "1.5.5-r.2"
	},
	"engines": {
		"node": ">=20"
	}
}
